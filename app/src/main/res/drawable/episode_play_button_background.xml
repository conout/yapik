<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/cover_default" />
            <stroke android:width="2dp" android:color="@color/control_outline" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/cover_default" />
            <stroke android:width="2dp" android:color="@color/control_outline" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/episode_play_background" />
            <stroke android:width="2dp" android:color="@color/episode_play_outline" />
        </shape>
    </item>
</selector>
