<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:elevation="12dp"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="12dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp"
    android:visibility="gone">

    <TextView
        android:id="@+id/playbackEpisodeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/playbackStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <SeekBar
        android:id="@+id/playbackSeekBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:max="1000"
        android:progressDrawable="@drawable/player_seekbar_progress"
        android:splitTrack="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/playbackElapsed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/playbackDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:textColor="@color/text_tertiary"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/playbackPrevious"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/player_control_button_background"
            android:contentDescription="@string/previous"
            android:elevation="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_previous"
            android:stateListAnimator="@null"
            android:tint="@color/player_control_button_text" />

        <Button
            android:id="@+id/playbackRewind"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/player_control_button_background"
            android:contentDescription="@string/rewind_15"
            android:elevation="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="−15"
            android:textAllCaps="false"
            android:textColor="@color/player_control_button_text" />

        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginStart="8dp">

            <ImageButton
                android:id="@+id/playbackPlayPause"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/player_primary_button_background"
                android:contentDescription="@string/play"
                android:elevation="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="13dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_play"
                android:stateListAnimator="@null"
                android:tint="@color/on_accent" />

            <ProgressBar
                android:id="@+id/playbackPlayPauseProgress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:clickable="false"
                android:indeterminateTint="@color/on_accent"
                android:visibility="gone" />

        </FrameLayout>

        <Button
            android:id="@+id/playbackForward"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/player_control_button_background"
            android:contentDescription="@string/forward_15"
            android:elevation="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="+15"
            android:textAllCaps="false"
            android:textColor="@color/player_control_button_text" />

        <ImageButton
            android:id="@+id/playbackNext"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/player_control_button_background"
            android:contentDescription="@string/next"
            android:elevation="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_next"
            android:stateListAnimator="@null"
            android:tint="@color/player_control_button_text" />

        <Button
            android:id="@+id/playbackSpeed"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/player_control_button_background"
            android:contentDescription="@string/playback_speed"
            android:elevation="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:stateListAnimator="@null"
            android:text="1×"
            android:textAllCaps="false"
            android:textColor="@color/player_control_button_text" />
    </LinearLayout>

</LinearLayout>
